# ── Database ───────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/enterprise_helpdesk

# ── Auth ───────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string

# ── CORS / WebSocket origins (comma-separated, no spaces) ──
FRONTEND_URLS=http://localhost:5173

# ── Mail (Gmail app password) ──────────────────────────────
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=

# ── Runtime ────────────────────────────────────────────────
# production enables segregation-of-duties + strict transactions
NODE_ENV=development
# true | false | unset (defaults to true only when NODE_ENV=production)
SOD_ENFORCE=
# true to fail instead of silently running without a MongoDB transaction
REQUIRE_TRANSACTIONS=

# ── Optional ───────────────────────────────────────────────
# Absolute path to a TTF font for Lao text in generated PDFs
PDF_FONT_PATH=
# Default timezone label
APP_TIMEZONE=Asia/Vientiane
